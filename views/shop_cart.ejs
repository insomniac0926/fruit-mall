<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>장바구니 - 프레시 마켓</title>
    <link rel="stylesheet" href="/stud11/stylesheets/style.css">
    <style>
        body { margin: 0; padding: 0; font-family: -apple-system, sans-serif; background-color: #f9fafb; color: #111827; }
        header { display: flex; justify-content: space-between; align-items: center; padding: 18px 40px; background-color: #ffffff; border-bottom: 1px solid #f3f4f6; box-sizing: border-box; width: 100%; }
        .header-left { display: flex; align-items: center; gap: 35px; }
        .header-left h1 { margin: 0; font-size: 1.4em; font-weight: 800; color: #10b981; }

        /* 다른 페이지와 일치하도록 align-items 추가 */
        nav { display: flex; gap: 24px; align-items: center; }
        nav a { text-decoration: none; color: #4b5563; font-weight: 500; font-size: 0.95em; }
        nav a:hover { color: #10b981; }

        .auth-zone { font-size: 0.9em; display: flex; align-items: center; gap: 12px; }
        .auth-zone a { color: #4b5563; text-decoration: none; font-weight: 500; }
        .user-tag { font-weight: 600; color: #047857; background-color: #ecfdf5; padding: 4px 10px; border-radius: 20px; }

        main { max-width: 900px; margin: 50px auto; padding: 0 20px; }
        .cart-title { font-size: 1.6em; font-weight: 800; margin-bottom: 30px; }
        .cart-card { background: white; border: 1px solid #e5e7eb; border-radius: 24px; padding: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.01); }
        .cart-item { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; border-bottom: 1px solid #f3f4f6; }
        .cart-item:last-child { border-bottom: none; }
        .item-left { display: flex; align-items: center; gap: 15px; }
        .item-emoji { font-size: 2em; }
        .item-name { font-weight: 700; font-size: 1.05em; color: #111827; }
        .item-price { font-weight: 600; color: #4b5563; }
        .btn-remove { background: none; border: none; color: #ef4444; font-weight: 600; cursor: pointer; font-size: 0.95em; }
        .btn-remove:hover { text-decoration: underline; }
        .cart-summary { margin-top: 30px; padding-top: 25px; border-top: 2px solid #f3f4f6; display: flex; justify-content: space-between; align-items: center; }
        .total-label { font-size: 1.1em; font-weight: 600; color: #4b5563; }
        .total-price { font-size: 1.6em; font-weight: 800; color: #111827; }
        .btn-checkout { display: block; text-align: center; width: 100%; box-sizing: border-box; background-color: #10b981; color: white; border: none; padding: 16px; border-radius: 14px; font-weight: 700; font-size: 1.1em; cursor: pointer; margin-top: 25px; transition: background-color 0.2s; }
        .btn-checkout:hover { background-color: #059669; }
        .empty-cart { text-align: center; color: #9ca3af; padding: 60px 0; font-size: 1.05em; }
        .btn-shop { display: inline-block; margin-top: 15px; color: #10b981; font-weight: 600; text-decoration: none; }
    </style>
</head>
<body>

<header>
    <div class="header-left">
        <h1>🌱 프레시 마켓</h1>
        <nav>
            <a href="/stud11/">홈</a>
            <a href="/stud11/shop/products">추천상품</a>
            <a href="/stud11/shop/products/all">전체상품</a>
            <a href="/stud11/shop/cart" style="color: #10b981; font-weight: 700;">장바구니</a>
            <a href="/stud11/post/list">고객센터</a>

            <%
            let checkAdmin = false;
            if (typeof user !== 'undefined' && user && (user.id === 'admin' || user.username === 'admin')) { checkAdmin = true; }
            if (typeof currentUser !== 'undefined' && currentUser && (currentUser.id === 'admin' || currentUser.username === 'admin')) { checkAdmin = true; }
            if (checkAdmin) {
            %>
                <a href="/stud11/admin" style="color: #ef4444; font-weight: 700;">👑 관리자 대시보드</a>
            <% } %>
        </nav>
    </div>
    <div class="auth-zone">
        <% if (typeof user !== 'undefined' && user) { %>
            <span class="user-tag">👤 <%= user.username || user.id %>님</span> |
            <a href="/stud11/mypage">마이페이지</a> |
            <a href="/stud11/logout" style="color: #ef4444;">로그아웃</a>
        <% } else { %>
            <a href="/stud11/login">로그인</a> |
            <a href="/stud11/register">회원가입</a>
        <% } %>
    </div>
</header>

<main>
    <div class="cart-title">🛒 내 장바구니</div>
    <div class="cart-card">
        <% if (typeof cartItems !== 'undefined' && cartItems && cartItems.length > 0) { %>
            <% cartItems.forEach((item, index) => { %>
                <div class="cart-item">
                    <div class="item-left">
                        <span class="item-emoji"><%= item.emoji %></span>
                        <div>
                            <div class="item-name"><%= item.name %></div>
                            <div class="item-price"><%= item.price.toLocaleString() %>원</div>
                        </div>
                    </div>
                    <form action="/stud11/shop/cart/remove" method="POST" style="margin: 0;">
                        <input type="hidden" name="index" value="<%= index %>">
                        <button type="submit" class="btn-remove">제거</button>
                    </form>
                </div>
            <% }) %>

            <div class="cart-summary">
                <span class="total-label">총 결제 예정 금액</span>
                <span class="total-price"><%= typeof totalPrice !== 'undefined' ? totalPrice.toLocaleString() : 0 %>원</span>
            </div>

            <form action="/stud11/shop/checkout" method="POST">
                <button type="submit" class="btn-checkout">💳 산지 직송 주문 결제하기</button>
            </form>

            <% if (typeof user !== 'undefined' && user && (user.id === 'admin' || user.username === 'admin')) { %>
                <a href="/stud11/admin" class="btn-checkout" style="background-color: #ef4444; margin-top: 10px; text-decoration: none;">👑 총괄 관리자 대시보드 마스터 키 가동</a>
            <% } %>

        <% } else { %>
            <div class="empty-cart">
                <p>장바구니가 비어 있습니다. 신선한 과일을 담아보세요!</p>
                <a href="/stud11/" class="btn-shop">과일 보러 가기 →</a>
            </div>
        <% } %>
    </div>
</main>

</body>
</html>